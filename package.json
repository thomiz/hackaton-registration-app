{
  "name": "hackathon-check-in-app",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.17" },
  "overrides": { "toad-cache": "3.7.0" },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:demo": "npm run fhir:build && vite --mode demo --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run fhir:build && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/main.ts",
    "configure": "tsx scripts/configure.ts",
    "ops": "tsx scripts/ops.ts",
    "test": "vitest run",
    "migrate:blaze": "tsx scripts/migrate-from-blaze.ts",
    "staff:generate": "tsx scripts/generate-staff.ts",
    "fhir:build": "sushi fhir",
    "fhir:package": "tsx scripts/package-fhir.ts",
    "fhir:validate": "tsx scripts/validate-fhir.ts",
    "fhir:fixtures": "tsx tests/export-fhir-fixtures.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/static": "7.0.4",
    "csv-parse": "5.6.0",
    "dotenv": "16.6.1",
    "fastify": "4.29.1",
    "fuse.js": "7.1.0",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/fhir": "0.0.44",
    "@types/node": "18.19.130",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fsh-sushi": "3.21.0",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
