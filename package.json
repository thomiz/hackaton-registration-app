{
  "name": "hackathon-check-in-app",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "toad-cache": "3.7.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:demo": "npm run fhir:build && vite --mode demo --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && tsc -p tsconfig.server.json",
    "build:demo": "npm run fhir:build && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "start": "node dist-server/server/main.js",
    "configure": "node dist-server/scripts/configure.js",
    "ops": "node dist-server/scripts/ops.js",
    "test": "vitest run",
    "migrate:blaze": "node dist-server/scripts/migrate-from-blaze.js",
    "staff:generate": "node dist-server/scripts/generate-staff.js",
    "fhir:build": "sushi fhir",
    "fhir:package": "tsx scripts/package-fhir.ts",
    "fhir:validate": "tsx scripts/validate-fhir.ts",
    "fhir:fixtures": "tsx tests/export-fhir-fixtures.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/static": "7.0.4",
    "csv-parse": "5.6.0",
    "fastify": "4.29.1",
    "fuse.js": "7.1.0",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/fhir": "0.0.44",
    "@types/node": "22.20.5",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fsh-sushi": "3.21.0",
    "jsqr": "1.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
